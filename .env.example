# PDFMathTranslate (pdf2zh-next v2) — Railway template
#
# Railway injects PORT automatically (defaults to 8080). The Web UI binds
# PDF2ZH_SERVER_PORT — keep it equal to PORT so the public domain reaches
# the app.

# --- Ports ---
PORT=8080
PDF2ZH_SERVER_PORT=8080

# --- Translation engine ---
# The default engine is SiliconFlow Free (no API key required) — the app
# selects it as the implicit default. Keep it in the Web UI (Settings →
# Convert → Translation) or set the matching PDF2ZH_* vars to make it sticky.
#
# The bundled Ollama sibling service is OPT-IN: set this to true and pull a
# model into it (ollama pull <model>) to translate fully locally on your infra.
PDF2ZH_OLLAMA=false

# Ollama API base URL. On Railway this is auto-linked to the sibling Ollama
# service's private domain over :11434 (see companion-mapping.json), so leave
# it blank in the deploy form to accept the auto-wired value.
# Locally, point it at your own Ollama (e.g. http://localhost:11434).
PDF2ZH_OLLAMA_HOST=

# Ollama model to translate with. NO MODEL IS PRE-PULLED — pick one and pull
# it first (ollama pull <model>), then set it here or in the Web UI Settings.
# e.g. PDF2ZH_OLLAMA_MODEL=qwen3:8b
PDF2ZH_OLLAMA_MODEL=

# --- Optional translation tuning ---
# Max tokens to predict per chunk (default 2000).
# PDF2ZH_NUM_PREDICT=2000
# Translations-per-second rate limit (default 4).
# PDF2ZH_QPS=4
